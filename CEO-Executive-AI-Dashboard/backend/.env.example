# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_dashboard

# AI Provider Configuration
# Set to 'openrouter' to use DeepSeek via OpenRouter, or 'openai' or 'gemini'
AI_PROVIDER=openrouter

# OpenRouter / OpenAI Config
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat

# Gemini Config (if not using OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Config
FRONTEND_URL=http://localhost:5173
