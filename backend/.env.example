APP_NAME="Hospital Management System API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/hospital_management_system

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed Admin Credentials (Development)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@hms.com

# AI Provider Configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_TOP_K=3

# CORS Origins (JSON array string)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
